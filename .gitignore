# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Cursor: ルールは共有、それ以外のローカル状態は除外
.cursor/*
!.cursor/rules/
!.cursor/rules/**

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# VS Code / Cursor IDE
# launch.json / settings.json は共有のため追跡する（無視しない）。
# 個人用ワークスペースだけ除外。
*.code-workspace

# Secrets / local env (絶対にコミットしない)
.env
.env.*
!.env.example
assets/env/**
!assets/env/.env.example
!assets/env/.gitkeep

# Local LLM weights / side-car dumps（巨大・ライセンス個別）
*.gguf
*.GGUF
**/local_llm/models/**
!**/local_llm/models/.gitkeep

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Keys / certificates (将来用の保険)
*.pem
*.p12
*.p8
*.mobileprovision
*.jks
*.keystore
**/google-services.json
**/GoogleService-Info.plist
**/secrets/**
**/credentials.json
**/service-account*.json
